{
  "name": "exceptional-lora-trainer",
  "version": "0.6.1",
  "private": true,
  "license": "GPL-3.0-only",
  "author": "特异人士AIGC",
  "repository": "github:114514dude/Teyi-LoRA-Trainer",
  "packageManager": "pnpm@11.19.0",
  "description": "特异人士的 LoRA 训练器 - Electron 液态玻璃前端",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win portable",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "30.5.1",
    "electron-builder": "^26.0.12",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.exceptional.loratrainer",
    "productName": "特异人士的 LoRA 训练器",
    "asar": true,
    "asarUnpack": [
      "backend/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ],
      "artifactName": "Exceptional-LoRA-Trainer-${version}.${ext}"
    }
  }
}
